<mxfile host="app.diagrams.net" agent="hand-written" version="24.0.0" type="device"><diagram name="Roadmap" id="roadmap"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="stage-m0" value="&lt;b&gt;M0: Audit and architecture&lt;/b&gt;&lt;br&gt;&lt;i&gt;Done&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="230" height="96" as="geometry"/></mxCell><mxCell id="stage-m1" value="&lt;b&gt;M1: Basic integration on Windows: policy, hook, runtime, OpenCode&lt;/b&gt;&lt;br&gt;&lt;i&gt;Done&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="230" height="96" as="geometry"/></mxCell><mxCell id="stage-m2" value="&lt;b&gt;M2: Deterministic tools: 20 MCP tools, failure parsing, tree-sitter&lt;/b&gt;&lt;br&gt;&lt;i&gt;Done&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="230" height="96" as="geometry"/></mxCell><mxCell id="stage-m3" value="&lt;b&gt;M3: State and loop detection; event log in a state directory&lt;/b&gt;&lt;br&gt;&lt;i&gt;Next&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="60" width="230" height="96" as="geometry"/></mxCell><mxCell id="stage-m4" value="&lt;b&gt;M4: Micro model as classifier or summariser (LFM2.5)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Planned&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="230" height="96" as="geometry"/></mxCell><mxCell id="stage-m5" value="&lt;b&gt;M5: Deep model on demand (Bonsai); one GPU model at a time&lt;/b&gt;&lt;br&gt;&lt;i&gt;Planned&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="226" width="230" height="96" as="geometry"/></mxCell><mxCell id="stage-m6" value="&lt;b&gt;M6: Context management&lt;/b&gt;&lt;br&gt;&lt;i&gt;Planned&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="226" width="230" height="96" as="geometry"/></mxCell><mxCell id="stage-m7" value="&lt;b&gt;M7: Jev integration: TLS and endpoint policy&lt;/b&gt;&lt;br&gt;&lt;i&gt;Planned&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="226" width="230" height="96" as="geometry"/></mxCell><mxCell id="stage-m8" value="&lt;b&gt;M8: LiteLLM for external providers, behind the policy&lt;/b&gt;&lt;br&gt;&lt;i&gt;Planned&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="230" height="96" as="geometry"/></mxCell><mxCell id="stage-m9" value="&lt;b&gt;M9: Security threat-model tests and egress audit&lt;/b&gt;&lt;br&gt;&lt;i&gt;Planned&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="392" width="230" height="96" as="geometry"/></mxCell><mxCell id="stage-m10" value="&lt;b&gt;M10: Evaluation on a Rust coding benchmark&lt;/b&gt;&lt;br&gt;&lt;i&gt;Planned&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="392" width="230" height="96" as="geometry"/></mxCell><mxCell id="stage-m11" value="&lt;b&gt;M11: Open-source release: licence, README, CI&lt;/b&gt;&lt;br&gt;&lt;i&gt;Planned&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;spacingRight=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="392" width="230" height="96" as="geometry"/></mxCell><mxCell id="e-0" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="stage-m0" target="stage-m1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-1" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="stage-m1" target="stage-m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-2" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="stage-m2" target="stage-m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-3" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="stage-m3" target="stage-m4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-4" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="stage-m4" target="stage-m5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-5" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="stage-m5" target="stage-m6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-6" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="stage-m6" target="stage-m7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-7" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="stage-m7" target="stage-m8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-8" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="stage-m8" target="stage-m9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-9" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="stage-m9" target="stage-m10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-10" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="stage-m10" target="stage-m11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Bridle milestones&lt;/b&gt;&lt;br&gt;Green: done. Yellow: next. Grey: planned.&lt;br&gt;Release 1 is Windows native. Status is kept in docs/progress.md." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="900" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Tool call flow" id="tool-call-flow"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f1" value="&lt;b&gt;1. Model asks&lt;/b&gt;&lt;br&gt;OpenCode to run a tool (bash, read, edit, or a local-agent_* tool)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="210" height="100" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;2. Plugin shim&lt;/b&gt;&lt;br&gt;tool.execute.before calls &lt;i&gt;agent hook tool-before&lt;/i&gt;. No policy logic here." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="210" height="100" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;3. Policy&lt;/b&gt;&lt;br&gt;Paths, secret files, shell arguments, command class" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="60" width="210" height="100" as="geometry"/></mxCell><mxCell id="f4" value="Verdict is Allow?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="790" y="45" width="170" height="130" as="geometry"/></mxCell><mxCell id="f5" value="&lt;b&gt;5. Tool runs&lt;/b&gt;&lt;br&gt;Only after an Allow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="60" width="200" height="100" as="geometry"/></mxCell><mxCell id="f6" value="&lt;b&gt;6. Redact output&lt;/b&gt;&lt;br&gt;Secret values removed before the model sees the result" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="230" width="200" height="100" as="geometry"/></mxCell><mxCell id="f7" value="&lt;b&gt;7. Log the decision&lt;/b&gt;&lt;br&gt;.local-agent/tool-events.jsonl, no secret values" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="230" width="220" height="100" as="geometry"/></mxCell><mxCell id="f8" value="&lt;b&gt;Blocked&lt;/b&gt;&lt;br&gt;Any verdict other than Allow. The reason goes back to the model." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="740" y="400" width="220" height="100" as="geometry"/></mxCell><mxCell id="f9" value="&lt;b&gt;Fail closed&lt;/b&gt;&lt;br&gt;If the hook cannot answer (bad config, missing binary), the call is blocked." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="290" y="400" width="230" height="100" as="geometry"/></mxCell><mxCell id="g1" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g2" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g3" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g4" value="Yes" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g5" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g6" value="" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g7" value="No" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="f4" target="f8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g8" value="cannot answer" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="f2" target="f9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flowlegend" value="&lt;b&gt;Bridle tool-call flow&lt;/b&gt;&lt;br&gt;Matches the numbered steps in the README; the tool run is shown as its own step here. Green is the path an allowed call takes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="900" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
