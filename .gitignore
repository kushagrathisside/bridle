# --- Rust build output ---
/target/
**/*.rs.bk

# --- TS shim tooling (type-check only) ---
node_modules/
*.tsbuildinfo

# --- Harness runtime state (R-16.2) ---
.local-agent/
.worktrees/

# --- Model weights & runtimes: never committed (R-42.1, D-2) ---
# Anchored to the repo root so source directories named `models/` are not ignored.
/models/
/runtimes/
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt

# --- Secrets (R-27.2, R-35.2) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Eval artefacts (raw results are regenerated; curated reports live in evals/reports/) ---
evals/results/

# --- Logs / OS / editors ---
*.log
logs/
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# --- Documentation site (site/) ---
site/node_modules/
site/dist/
site/.astro/
site/src/content/docs/
